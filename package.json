{
	"name": "ardoise",
	"version": "0.1.0",
	"description": "The corner-shop credit book that family abroad can settle over Bitcoin Lightning.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.sw.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:nwc": "vitest --run --config vitest.nwc.config.ts",
		"verify": "npm run lint && npm run check && npm run test && npm run build"
	},
	"dependencies": {
		"@electric-sql/pglite": "^0.5.16",
		"@getalby/sdk": "^9.0.0",
		"@noble/curves": "^2.4.0",
		"@noble/hashes": "^2.4.0",
		"@scure/base": "^2.4.0",
		"@vercel/functions": "^3.11.3",
		"light-bolt11-decoder": "^3.2.0",
		"pg": "^8.23.1",
		"uqr": "^0.1.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/atkinson-hyperlegible-next": "^5.3.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/adapter-vercel": "^7.0.3",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@types/pg": "^8.23.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	}
}
