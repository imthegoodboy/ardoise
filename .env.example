# Copy to .env for local development. Every value is optional locally.

# Postgres connection. Without it, Ardoise uses an embedded Postgres (PGlite) in ./.data
# DATABASE_URL=postgres://ardoise:ardoise@localhost:5432/ardoise

# Master secret for encryption at rest and hashing. 32+ random characters.
# Without it, a key is generated in ./.data/secret.key (not possible on serverless hosts).
# ARDOISE_SECRET=

# The "Try the demo" button:
#   off       - no demo
#   simulated - private sandbox shops with a simulated wallet (regtest invoices)
#   faucet    - private sandbox shops wired to a real NWC test wallet (faucet.nwc.dev),
#               reached over public Nostr relays; falls back to simulated if unreachable
ARDOISE_DEMO=faucet

# Optional: a real receive-only NWC connection for demo shops (real sats).
# ARDOISE_DEMO_NWC_URL=nostr+walletconnect://...

# Reading paper notebook pages with Google Gemini.
# GEMINI_API_KEY=
# ARDOISE_AI_MODEL=gemini-3.5-flash

# Protects /api/cron/reconcile (Vercel Cron sends it as a Bearer token).
# CRON_SECRET=

# Only for local experiments: allow NWC relays on private networks / spend-capable connections.
# ARDOISE_ALLOW_PRIVATE_HOSTS=false
# ARDOISE_ALLOW_SPEND_CAPABLE_NWC=false

# LOG_LEVEL=info
